# DYRO STUDIOS — configuration du serveur (Hostinger : Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obligatoire et adresse unique https://dyrostudios.com (sans www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://dyrostudios.com%{REQUEST_URI} [L,R=301]

  # Une seule adresse par page : /index.html → /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

  # Anciennes adresses du site (Horizons) → nouvelles sections
  RewriteRule ^(avant-apres|galerie|concepts(/.*)?)/?$ /#avant-apres [NE,L,R=301]
  RewriteRule ^tarifs/?$ /#tarifs [NE,L,R=301]
  RewriteRule ^notre-methode/?$ /#methode [NE,L,R=301]
  RewriteRule ^services/?$ /#services [NE,L,R=301]
  RewriteRule ^publicites-automobiles/?$ /publicites/#auto [NE,L,R=301]
  RewriteRule ^publicites-ia-marques/?$ /publicites/#marques [NE,L,R=301]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache navigateur (CSS/JS versionnés par ?v=)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>
AddType font/woff2 .woff2

# Taille maximale d'envoi (photo de 10 Mo + champs)
<IfModule mod_php.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 14M
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fichiers et dossiers techniques inaccessibles
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(\.git|scripts|src)(/|$)
</IfModule>
<FilesMatch "^(README\.md|\.gitignore|\.htaccess|\.user\.ini)$">
  Require all denied
</FilesMatch>
